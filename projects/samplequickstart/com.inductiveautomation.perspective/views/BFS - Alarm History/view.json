            "meta": { "name": "ActiveLabel" },
            "props": {
              "text": "ACTIVE & UNACKNOWLEDGED ALARMS",
              "style": { "color": "#90A4AE", "fontSize": "10px", "letterSpacing": "1.5px", "fontFamily": "monospace" }
            },
            "type": "ia.display.label"
          },
          {
            "meta": { "name": "AlarmStatusTable" },
            "position": { "grow": 1, "basis": "0" },
            "props": {
              "alarmFilter": {
                "source": "[default]BFS/**",
                "state": "ActiveUnacked,ActiveAcked,ClearUnacked"
              },
              "columns": [
                { "field": "priority", "header": "PRIORITY", "width": 110 },
                { "field": "displayPath", "header": "SOURCE", "width": 280 },
                { "field": "label", "header": "DESCRIPTION", "width": 380 },
                { "field": "activeDate", "header": "ACTIVE TIME", "width": 180 },
                { "field": "ackDate", "header": "ACK TIME", "width": 160 },
                { "field": "state", "header": "STATE", "width": 120 }
              ],
              "style": {
                "backgroundColor": "#263238",
                "fontFamily": "monospace",
                "fontSize": "12px"
              }
            },
            "type": "ia.display.alarmstatustable"
          }
        ],
        "type": "ia.container.flex"
      },
      {
        "meta": { "name": "AlarmReferenceSection" },
