                "children": [
                  {
                    "meta": { "name": "Ref2Header" },
                    "props": {
                      "text": "PRIORITY",
                      "style": { "color": "#546E7A", "fontSize": "9px", "letterSpacing": "1px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "Ref2a" },
                    "props": {
                      "text": "Critical",
                      "style": { "color": "#FFCC80", "fontSize": "11px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "Ref2b" },
                    "props": {
                      "text": "Critical",
                      "style": { "color": "#FFCC80", "fontSize": "11px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  }
                ],
                "type": "ia.container.flex"
              },
              {
                "meta": { "name": "Col3" },
                "props": {
                  "direction": "column",
                  "style": { "gap": "4px" }
                },
                "children": [
                  {
                    "meta": { "name": "Ref3Header" },
                    "props": {
                      "text": "REQUIRED ACTION",
                      "style": { "color": "#546E7A", "fontSize": "9px", "letterSpacing": "1px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "Ref3a" },
                    "props": {
                      "text": "Stop filling, investigate fault, press FAULT RESET on Overview",
                      "style": { "color": "#90A4AE", "fontSize": "11px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "Ref3b" },
                    "props": {
                      "text": "Check beam alignment, 24VDC supply, and lens on LS-01",
                      "style": { "color": "#90A4AE", "fontSize": "11px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  }
                ],
                "type": "ia.container.flex"
              }
            ],
            "type": "ia.container.flex"
          }
        ],
        "type": "ia.container.flex"
      }
    ],
    "meta": { "name": "root" },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "#455A64",
        "height": "100%",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
