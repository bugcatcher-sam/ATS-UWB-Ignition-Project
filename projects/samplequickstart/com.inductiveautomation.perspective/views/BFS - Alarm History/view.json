                  {
                    "meta": { "name": "Ref1a" },
                    "props": {
                      "text": "BFS/System/State  —  System Fault",
                      "style": { "color": "#90A4AE", "fontSize": "11px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "Ref1b" },
                    "props": {
                      "text": "BFS/Sensor/Health  —  Laser Sensor Fault",
                      "style": { "color": "#90A4AE", "fontSize": "11px", "fontFamily": "monospace" }
