                "color": "#ECEFF1",
                "fontSize": "15px",
                "fontWeight": "600",
                "letterSpacing": "1px",
                "fontFamily": "monospace"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": { "name": "ISANote" },
