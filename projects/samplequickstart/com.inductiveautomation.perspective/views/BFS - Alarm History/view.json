            "type": "ia.container.flex"
          }
        ],
        "type": "ia.container.flex"
      },
      {
        "meta": { "name": "ActiveAlarmSection" },
        "position": { "grow": 1, "basis": "0" },
        "props": {
          "direction": "column",
          "style": {
            "backgroundColor": "#455A64",
            "padding": "16px 24px 8px 24px",
            "gap": "8px"
          }
