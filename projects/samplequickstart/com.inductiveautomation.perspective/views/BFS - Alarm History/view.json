{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": { "height": 688, "width": 1024 }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": { "name": "root" },
    "props": {
      "direction": "column",
      "style": { "backgroundColor": "#C8C8C8", "width": "100%", "height": "100%" }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": { "name": "TitleBar" },
        "position": { "basis": "40px", "shrink": 0 },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": { "backgroundColor": "#3D3D3D", "padding": "0 14px", "gap": "12px", "borderBottom": "2px solid #555555" }
        },
        "children": [
          { "type": "ia.display.label", "position": { "grow": 1 }, "props": { "text": "AUTOMATED BOTTLE FILLER  —  ALARM MANAGEMENT", "style": { "color": "#E0E0E0", "fontSize": "15px", "fontWeight": "600", "fontFamily": "monospace", "letterSpacing": "0.5px" } } },
          {
            "type": "ia.display.label",
            "propConfig": {
              "props.text": { "binding": { "type": "tag", "tagPath": "[default]BFS/System/AlarmActiveCount", "transforms": [{ "type": "expr", "expression": "toStr({value}) + ' Active'" }] } },
              "props.style.backgroundColor": { "binding": { "type": "tag", "tagPath": "[default]BFS/System/AlarmActiveCount", "transforms": [{ "type": "map", "map": { "0": "#424242" }, "fallback": "#B71C1C" }] } }
            },
            "props": { "text": "0 Active", "style": { "backgroundColor": "#424242", "color": "#FFFFFF", "fontSize": "13px", "fontWeight": "700", "fontFamily": "monospace", "padding": "4px 12px" } }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": { "name": "AlarmActions" },
        "position": { "basis": "40px", "shrink": 0 },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": { "backgroundColor": "#C0C0C0", "borderBottom": "2px solid #999999", "padding": "0 14px", "gap": "10px" }
        },
        "children": [
          { "type": "ia.display.label", "props": { "text": "ACTIVE ALARMS:", "style": { "color": "#444444", "fontSize": "12px", "fontFamily": "monospace", "fontWeight": "700" } } },
          {
            "type": "ia.input.button",
            "props": {
              "text": "ACK SELECTED",
              "style": { "backgroundColor": "#616161", "color": "#FFFFFF", "fontFamily": "monospace", "fontSize": "12px", "fontWeight": "700", "padding": "5px 12px" }
            }
          },
          {
            "type": "ia.input.button",
            "props": {
              "text": "ACK ALL",
              "action": {
                "type": "script",
                "config": { "script": "alarms = system.alarm.queryStatus(source='[default]BFS/*', state=['ActiveUnacknowledged'])\nfor alarm in alarms:\n\tsystem.alarm.acknowledge([alarm.id], 'Acknowledged via HMI')" }
              },
              "style": { "backgroundColor": "#616161", "color": "#FFFFFF", "fontFamily": "monospace", "fontSize": "12px", "fontWeight": "700", "padding": "5px 12px" }
            }
          },
          { "type": "ia.display.label", "position": { "grow": 1 } },
          { "type": "ia.display.label", "props": { "text": "ALARM HISTORY:", "style": { "color": "#444444", "fontSize": "12px", "fontFamily": "monospace", "fontWeight": "700" } } },
          {
            "type": "ia.input.button",
            "props": { "text": "EXPORT CSV", "style": { "backgroundColor": "#616161", "color": "#FFFFFF", "fontFamily": "monospace", "fontSize": "12px", "fontWeight": "700", "padding": "5px 12px" } }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": { "name": "AlarmTableSection" },
        "propConfig": {
          "position.basis": {
            "binding": { "type": "expr", "expression": "toStr({session.custom.alarmTableHeight}) + 'px'" }
          }
        },
        "position": { "basis": "220px", "shrink": 0 },
        "props": {
          "direction": "column",
          "style": { "padding": "4px 12px 0 12px" }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": { "name": "ActiveAlarmSectionLabel" },
            "position": { "basis": "22px", "shrink": 0 },
            "props": {
              "text": "▼  ACTIVE ALARMS",
              "style": { "color": "#444444", "fontSize": "12px", "fontFamily": "monospace", "fontWeight": "700", "letterSpacing": "0.5px", "padding": "2px 0" }
            }
          },
          {
            "type": "ia.display.alarmstatustable",
            "meta": { "name": "ActiveAlarmTable" },
            "position": { "grow": 1 },
            "props": {
              "showFilter": true,
              "columns": [
                { "field": "priority", "header": "Priority", "visible": true },
                { "field": "displayPath", "header": "Source", "visible": true },
                { "field": "name", "header": "Alarm Name", "visible": true },
                { "field": "activeTime", "header": "Active Time", "visible": true },
                { "field": "ackTime", "header": "Ack Time", "visible": true }
              ]
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": { "name": "SplitterBar" },
        "position": { "basis": "32px", "shrink": 0 },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "justifyContent": "center",
          "style": {
            "backgroundColor": "#9E9E9E",
            "borderTop": "3px solid #707070",
            "borderBottom": "3px solid #707070",
            "cursor": "ns-resize",
            "gap": "20px"
          }
        },
        "children": [
          {
            "type": "ia.input.button",
            "props": {
              "text": "▲  More alarms",
              "action": {
                "type": "script",
                "config": { "script": "current = self.session.custom.alarmTableHeight\nnewHeight = current - 60\nif newHeight < 80:\n\tnewHeight = 80\nsystem.perspective.setSessionVariable('custom.alarmTableHeight', newHeight)" }
              },
              "style": { "backgroundColor": "#808080", "color": "#EEEEEE", "fontSize": "11px", "fontFamily": "monospace", "border": "none", "padding": "3px 12px", "borderRadius": "2px" }
            }
          },
          {
            "type": "ia.display.label",
            "props": {
              "text": "≡  RESIZE  ≡",
              "style": { "color": "#555555", "fontSize": "11px", "fontFamily": "monospace", "letterSpacing": "1px" }
            }
          },
          {
            "type": "ia.input.button",
            "props": {
              "text": "▼  More history",
              "action": {
                "type": "script",
                "config": { "script": "current = self.session.custom.alarmTableHeight\nnewHeight = current + 60\nif newHeight > 420:\n\tnewHeight = 420\nsystem.perspective.setSessionVariable('custom.alarmTableHeight', newHeight)" }
              },
              "style": { "backgroundColor": "#808080", "color": "#EEEEEE", "fontSize": "11px", "fontFamily": "monospace", "border": "none", "padding": "3px 12px", "borderRadius": "2px" }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": { "name": "JournalSection" },
        "position": { "grow": 1 },
        "props": {
          "direction": "column",
          "style": { "padding": "0 12px 8px 12px", "gap": "4px" }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": { "name": "JournalSectionLabel" },
            "position": { "basis": "22px", "shrink": 0 },
            "props": {
              "text": "▼  ALARM HISTORY  (all cleared and acknowledged events)",
              "style": { "color": "#444444", "fontSize": "12px", "fontFamily": "monospace", "fontWeight": "700", "letterSpacing": "0.5px", "padding": "2px 0" }
            }
          },
          {
            "type": "ia.display.alarmjournal",
            "meta": { "name": "AlarmJournal" },
            "position": { "grow": 1 },
            "props": {
              "showFilter": true,
              "columns": [
                { "field": "priority", "header": "Priority", "visible": true },
                { "field": "displayPath", "header": "Source", "visible": true },
                { "field": "name", "header": "Alarm", "visible": true },
                { "field": "activeTime", "header": "Active Time", "visible": true },
                { "field": "clearedTime", "header": "Cleared Time", "visible": true },
                { "field": "ackTime", "header": "Ack Time", "visible": true },
                { "field": "duration", "header": "Duration", "visible": true }
              ]
            }
          }
        ]
      }
    ]
  }
}
