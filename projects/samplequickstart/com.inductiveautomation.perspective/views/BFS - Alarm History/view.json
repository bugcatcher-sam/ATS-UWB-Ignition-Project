{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 664,
      "width": 1024
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": { "name": "root" },
    "props": {
      "direction": "column",
      "style": { "backgroundColor": "#C8C8C8", "width": "100%", "height": "100%" }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": { "name": "TitleBar" },
        "position": { "basis": "36px", "shrink": 0 },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": { "backgroundColor": "#3D3D3D", "padding": "0 12px", "gap": "12px", "borderBottom": "2px solid #555555" }
        },
        "children": [
          { "type": "ia.display.label", "position": { "grow": 1 }, "props": { "text": "AUTOMATED BOTTLE FILLER  —  ALARM MANAGEMENT  (ISA-18.2)", "style": { "color": "#E0E0E0", "fontSize": "13px", "fontWeight": "600", "fontFamily": "monospace", "letterSpacing": "0.5px" } } },
          {
            "type": "ia.display.label",
            "propConfig": {
              "props.text": { "binding": { "type": "tag", "tagPath": "[default]BFS/System/AlarmActiveCount", "transforms": [{ "type": "expr", "expression": "toStr({value}) + ' Active'" }] } },
              "props.style.backgroundColor": { "binding": { "type": "tag", "tagPath": "[default]BFS/System/AlarmActiveCount", "transforms": [{ "type": "map", "map": { "0": "#424242" }, "fallback": "#B71C1C" }] } }
            },
            "props": { "text": "0 Active", "style": { "backgroundColor": "#424242", "color": "#FFFFFF", "fontSize": "11px", "fontWeight": "700", "fontFamily": "monospace", "padding": "3px 10px" } }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": { "name": "ISALegend" },
        "position": { "basis": "28px", "shrink": 0 },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": { "backgroundColor": "#BBBBBB", "borderBottom": "1px solid #AAAAAA", "padding": "0 12px", "gap": "16px" }
        },
        "children": [
          { "type": "ia.display.label", "props": { "text": "PRIORITY:", "style": { "color": "#555555", "fontSize": "10px", "fontFamily": "monospace", "fontWeight": "700" } } },
          { "type": "ia.display.label", "props": { "text": "■ CRITICAL (P1)", "style": { "color": "#B71C1C", "fontSize": "10px", "fontFamily": "monospace" } } },
          { "type": "ia.display.label", "props": { "text": "■ HIGH (P2)", "style": { "color": "#C62828", "fontSize": "10px", "fontFamily": "monospace" } } },
          { "type": "ia.display.label", "props": { "text": "■ MEDIUM (P3)", "style": { "color": "#E65100", "fontSize": "10px", "fontFamily": "monospace" } } },
          { "type": "ia.display.label", "props": { "text": "■ LOW (P4)", "style": { "color": "#F57F17", "fontSize": "10px", "fontFamily": "monospace" } } },
          { "type": "ia.display.label", "props": { "text": "  |  ISA-18.2 Compliant Alarm Management", "style": { "color": "#777777", "fontSize": "10px", "fontFamily": "monospace" } } }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": { "name": "AlarmActions" },
        "position": { "basis": "36px", "shrink": 0 },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": { "backgroundColor": "#C0C0C0", "borderBottom": "1px solid #AAAAAA", "padding": "0 12px", "gap": "8px" }
        },
        "children": [
          { "type": "ia.display.label", "props": { "text": "ACTIVE ALARMS:", "style": { "color": "#444444", "fontSize": "10px", "fontFamily": "monospace", "fontWeight": "700" } } },
          {
            "type": "ia.input.button",
            "props": {
              "text": "ACK SELECTED",
              "style": { "backgroundColor": "#616161", "color": "#FFFFFF", "fontFamily": "monospace", "fontSize": "11px", "fontWeight": "700", "padding": "4px 10px" }
            }
          },
          {
            "type": "ia.input.button",
            "props": {
              "text": "ACK ALL",
              "action": {
                "type": "script",
                "config": {
                  "script": "alarms = system.alarm.queryStatus(source='[default]BFS/*', state=['ActiveUnacknowledged'])\nfor alarm in alarms:\n\tsystem.alarm.acknowledge([alarm.id], 'Acknowledged via HMI')"
                }
              },
              "style": { "backgroundColor": "#616161", "color": "#FFFFFF", "fontFamily": "monospace", "fontSize": "11px", "fontWeight": "700", "padding": "4px 10px" }
            }
          },
          { "type": "ia.display.label", "position": { "grow": 1 } },
          { "type": "ia.display.label", "props": { "text": "ALARM JOURNAL:", "style": { "color": "#444444", "fontSize": "10px", "fontFamily": "monospace", "fontWeight": "700" } } },
          {
            "type": "ia.input.button",
            "props": {
              "text": "EXPORT CSV",
              "style": { "backgroundColor": "#616161", "color": "#FFFFFF", "fontFamily": "monospace", "fontSize": "11px", "fontWeight": "700", "padding": "4px 10px" }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": { "name": "AlarmTableSection" },
        "position": { "basis": "260px", "shrink": 0 },
        "props": {
          "direction": "column",
          "style": { "padding": "4px 12px 4px 12px", "gap": "0px" }
        },
        "children": [
          {
            "type": "ia.display.alarmstatustable",
            "meta": { "name": "ActiveAlarmTable" },
            "position": { "grow": 1 },
            "props": {
              "showFilter": true,
              "columns": [
                { "field": "priority", "header": "Priority", "visible": true },
                { "field": "displayPath", "header": "Source", "visible": true },
                { "field": "name", "header": "Alarm Name", "visible": true },
                { "field": "activeTime", "header": "Active Time", "visible": true },
                { "field": "ackTime", "header": "Ack Time", "visible": true },
                { "field": "notes", "header": "Notes", "visible": true }
              ]
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": { "name": "JournalSection" },
        "position": { "grow": 1 },
        "props": {
          "direction": "column",
          "style": { "padding": "0 12px 8px 12px", "gap": "4px" }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": { "name": "JournalHeader" },
            "position": { "basis": "28px", "shrink": 0 },
            "props": {
              "direction": "row",
              "alignItems": "center",
              "style": { "backgroundColor": "#BBBBBB", "border": "1px solid #AAAAAA", "padding": "0 8px", "borderBottom": "none", "gap": "8px" }
            },
            "children": [
              { "type": "ia.display.label", "props": { "text": "ALARM JOURNAL  —  HISTORY", "style": { "color": "#444444", "fontSize": "10px", "fontFamily": "monospace", "fontWeight": "700", "letterSpacing": "0.5px" } } }
            ]
          },
          {
            "type": "ia.display.alarmjournal",
            "meta": { "name": "AlarmJournal" },
            "position": { "grow": 1 },
            "props": {
              "showFilter": true,
              "columns": [
                { "field": "priority", "header": "Priority", "visible": true },
                { "field": "displayPath", "header": "Source", "visible": true },
                { "field": "name", "header": "Alarm", "visible": true },
                { "field": "activeTime", "header": "Active Time", "visible": true },
                { "field": "clearedTime", "header": "Cleared Time", "visible": true },
                { "field": "ackTime", "header": "Ack Time", "visible": true },
                { "field": "duration", "header": "Duration", "visible": true }
              ]
            }
          }
        ]
      }
    ]
  }
}
