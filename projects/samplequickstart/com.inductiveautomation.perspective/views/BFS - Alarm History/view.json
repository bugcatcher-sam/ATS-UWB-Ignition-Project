{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 900,
      "width": 1280
    }
  },
  "root": {
    "children": [
      {
        "meta": { "name": "Header" },
        "position": { "basis": "56px", "shrink": 0 },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": {
            "backgroundColor": "#37474F",
            "padding": "0 24px",
            "gap": "16px",
            "borderBottom": "2px solid #263238"
          }
        },
        "children": [
          {
            "meta": { "name": "BackBtn" },
            "props": {
              "text": "‹ OVERVIEW",
              "style": {
                "backgroundColor": "#455A64",
                "color": "#B0BEC5",
                "fontSize": "12px",
                "padding": "6px 14px",
                "fontFamily": "monospace",
                "letterSpacing": "0.5px"
              },
              "action": { "type": "page", "config": { "url": "/bfs-overview" } }
            },
            "type": "ia.input.button"
          },
          {
            "meta": { "name": "Title" },
            "position": { "grow": 1 },
            "props": {
              "text": "ALARM MANAGEMENT  —  BFS  |  LEVEL 4",
