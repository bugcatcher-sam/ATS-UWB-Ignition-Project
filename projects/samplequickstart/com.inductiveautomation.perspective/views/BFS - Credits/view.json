              { "type": "ia.display.label", "props": { "text": "— Solenoid Valve SV-001", "style": { "color": "#222222", "fontSize": "11px", "fontFamily": "monospace" } } },
              { "type": "ia.display.label", "props": { "text": "— Laser Detector LS-001", "style": { "color": "#222222", "fontSize": "11px", "fontFamily": "monospace" } } },
              { "type": "ia.display.label", "props": { "text": "— Water Supply Tank TK-001", "style": { "color": "#222222", "fontSize": "11px", "fontFamily": "monospace" } } },
