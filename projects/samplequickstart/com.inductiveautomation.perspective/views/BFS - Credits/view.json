              { "type": "ia.display.label", "props": { "text": "— 16.9 oz (500 mL) Bottles", "style": { "color": "#222222", "fontSize": "11px", "fontFamily": "monospace" } } },
              { "type": "ia.display.label", "props": { "text": "— 1024 × 768 Display Target", "style": { "color": "#222222", "fontSize": "11px", "fontFamily": "monospace" } } }
