              { "type": "ia.display.label", "props": { "text": "— ISA-101 HMI Design Standard", "style": { "color": "#222222", "fontSize": "11px", "fontFamily": "monospace" } } },
              { "type": "ia.display.label", "props": { "text": "— ISA-18.2 Alarm Management", "style": { "color": "#222222", "fontSize": "11px", "fontFamily": "monospace" } } },
              { "type": "ia.display.label", "props": { "text": "— ISA 5.1 P&ID Symbology", "style": { "color": "#222222", "fontSize": "11px", "fontFamily": "monospace" } } },
