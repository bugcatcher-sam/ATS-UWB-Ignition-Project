{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": { "height": 80, "width": 1024 }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": { "name": "root" },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "#2D2D2D",
        "overflow": "hidden",
        "width": "100%",
        "height": "100%"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": { "name": "TopRow" },
        "position": { "basis": "50px", "shrink": 0 },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": {
            "borderBottom": "1px solid #444444",
            "padding": "0 10px",
            "gap": "8px"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": { "name": "UWBLogoBlock" },
            "position": { "basis": "220px", "shrink": 0 },
            "props": {
              "direction": "row",
              "alignItems": "center",
              "style": { "gap": "8px" }
            },
            "children": [
              {
                "type": "ia.display.image",
                "meta": { "name": "UWBLogo" },
                "props": {
                  "source": "/system/webdev/samplequickstart/uwb-logo.png",
                  "style": {
                    "height": "38px",
                    "width": "38px",
                    "objectFit": "contain",
                    "borderRadius": "2px",
                    "backgroundColor": "#FFFFFF"
                  }
                }
              },
              {
                "type": "ia.container.flex",
                "props": {
                  "direction": "column",
                  "justifyContent": "center",
                  "style": { "gap": "1px" }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "props": {
                      "text": "University of Washington",
                      "style": {
                        "color": "#D4C5F0",
                        "fontSize": "11px",
                        "fontFamily": "Arial, sans-serif",
                        "letterSpacing": "0.2px"
                      }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "props": {
                      "text": "Bothell",
                      "style": {
                        "color": "#FFFFFF",
                        "fontSize": "13px",
                        "fontWeight": "700",
                        "fontFamily": "Arial, sans-serif"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "meta": { "name": "AlarmSummarySection" },
            "position": { "grow": 1 },
            "props": {
              "direction": "column",
              "justifyContent": "center",
              "style": {
                "padding": "2px 8px",
                "gap": "2px",
                "overflow": "hidden"
              }
            },
            "children": [
              {
                "type": "ia.container.flex",
                "meta": { "name": "AlarmCountRow" },
                "props": {
                  "direction": "row",
                  "alignItems": "center",
                  "style": { "gap": "10px" }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "props": {
                      "text": "ACTIVE ALARMS",
                      "style": {
                        "color": "#888888",
                        "fontSize": "10px",
                        "fontFamily": "monospace",
                        "letterSpacing": "0.5px"
                      }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": { "name": "AlarmActiveBadge" },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "type": "tag",
                          "tagPath": "[default]BFS/System/AlarmActiveCount",
                          "transforms": [{ "type": "expr", "expression": "toStr({value})" }]
                        }
                      },
                      "props.style.backgroundColor": {
                        "binding": {
                          "type": "tag",
                          "tagPath": "[default]BFS/System/AlarmActiveCount",
                          "transforms": [{ "type": "map", "map": { "0": "#424242" }, "fallback": "#B71C1C" }]
                        }
                      }
                    },
                    "props": {
                      "text": "0",
                      "style": {
                        "backgroundColor": "#424242",
                        "color": "#FFFFFF",
                        "fontSize": "13px",
                        "fontWeight": "700",
                        "padding": "0px 8px",
                        "borderRadius": "2px",
                        "fontFamily": "monospace",
                        "minWidth": "24px",
                        "textAlign": "center"
                      }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "props": {
                      "text": "UNACK",
                      "style": { "color": "#888888", "fontSize": "10px", "fontFamily": "monospace", "marginLeft": "6px" }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": { "name": "AlarmUnackBadge" },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "type": "tag",
                          "tagPath": "[default]BFS/System/AlarmUnackCount",
                          "transforms": [{ "type": "expr", "expression": "toStr({value})" }]
                        }
                      },
                      "props.style.backgroundColor": {
                        "binding": {
                          "type": "tag",
                          "tagPath": "[default]BFS/System/AlarmUnackCount",
                          "transforms": [{ "type": "map", "map": { "0": "#424242" }, "fallback": "#E65100" }]
                        }
                      }
                    },
                    "props": {
                      "text": "0",
                      "style": {
                        "backgroundColor": "#424242",
                        "color": "#FFFFFF",
                        "fontSize": "13px",
                        "fontWeight": "700",
                        "padding": "0px 8px",
                        "borderRadius": "2px",
                        "fontFamily": "monospace",
                        "minWidth": "24px",
                        "textAlign": "center"
                      }
                    }
                  }
                ]
              },
              {
                "type": "ia.container.flex",
                "meta": { "name": "AlarmTextList" },
                "props": {
                  "direction": "row",
                  "style": { "gap": "12px", "flexWrap": "nowrap", "overflow": "hidden" }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "propConfig": {
                      "props.style.display": {
                        "binding": {
                          "type": "tag",
                          "tagPath": "[default]BFS/System/EStop",
                          "transforms": [{ "type": "map", "map": { "true": "block" }, "fallback": "none" }]
                        }
                      }
                    },
                    "props": {
                      "text": "● E-STOP",
                      "style": { "color": "#EF5350", "fontSize": "11px", "fontFamily": "monospace", "fontWeight": "700", "display": "none" }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "propConfig": {
                      "props.style.display": {
                        "binding": {
                          "type": "tag",
                          "tagPath": "[default]BFS/Pump/P001_Fault",
                          "transforms": [{ "type": "map", "map": { "true": "block" }, "fallback": "none" }]
                        }
                      }
                    },
                    "props": {
                      "text": "● PUMP FAULT",
                      "style": { "color": "#EF5350", "fontSize": "11px", "fontFamily": "monospace", "fontWeight": "700", "display": "none" }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "propConfig": {
                      "props.style.display": {
                        "binding": {
                          "type": "tag",
                          "tagPath": "[default]BFS/Valve/SV001_Fault",
                          "transforms": [{ "type": "map", "map": { "true": "block" }, "fallback": "none" }]
                        }
                      }
                    },
                    "props": {
                      "text": "● VALVE FAULT",
                      "style": { "color": "#EF5350", "fontSize": "11px", "fontFamily": "monospace", "fontWeight": "700", "display": "none" }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "propConfig": {
                      "props.style.display": {
                        "binding": {
                          "type": "tag",
                          "tagPath": "[default]BFS/Sensor/Health",
                          "transforms": [{ "type": "map", "map": { "false": "block" }, "fallback": "none" }]
                        }
                      }
                    },
                    "props": {
                      "text": "● LASER FAULT",
                      "style": { "color": "#EF5350", "fontSize": "11px", "fontFamily": "monospace", "fontWeight": "700", "display": "none" }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "propConfig": {
                      "props.style.display": {
                        "binding": {
                          "type": "tag",
                          "tagPath": "[default]BFS/System/StartFailed",
                          "transforms": [{ "type": "map", "map": { "true": "block" }, "fallback": "none" }]
                        }
                      }
                    },
                    "props": {
                      "text": "● START FAILED",
                      "style": { "color": "#FFA726", "fontSize": "11px", "fontFamily": "monospace", "fontWeight": "700", "display": "none" }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "propConfig": {
                      "props.style.display": {
                        "binding": {
                          "type": "tag",
                          "tagPath": "[default]BFS/System/StopFailed",
                          "transforms": [{ "type": "map", "map": { "true": "block" }, "fallback": "none" }]
                        }
                      }
                    },
                    "props": {
                      "text": "● STOP FAILED",
                      "style": { "color": "#FFA726", "fontSize": "11px", "fontFamily": "monospace", "fontWeight": "700", "display": "none" }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": { "name": "NoAlarmText" },
                    "propConfig": {
                      "props.style.display": {
                        "binding": {
                          "type": "tag",
                          "tagPath": "[default]BFS/System/AlarmActiveCount",
                          "transforms": [{ "type": "map", "map": { "0": "block" }, "fallback": "none" }]
                        }
                      }
                    },
                    "props": {
                      "text": "No active alarms",
                      "style": { "color": "#666666", "fontSize": "11px", "fontFamily": "monospace", "fontStyle": "italic", "display": "block" }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "meta": { "name": "ATSLogoBlock" },
            "position": { "basis": "220px", "shrink": 0 },
            "props": {
              "direction": "row",
              "alignItems": "center",
              "justifyContent": "flex-end",
              "style": { "gap": "8px" }
            },
            "children": [
              {
                "type": "ia.container.flex",
                "props": {
                  "direction": "column",
                  "alignItems": "flex-end",
                  "justifyContent": "center",
                  "style": { "gap": "1px" }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "props": {
                      "text": "ATS Industrial",
                      "style": {
                        "color": "#FFFFFF",
                        "fontSize": "13px",
                        "fontWeight": "700",
                        "fontFamily": "Arial, sans-serif"
                      }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "props": {
                      "text": "Automated Bottle Filler",
                      "style": {
                        "color": "#AAAAAA",
                        "fontSize": "11px",
                        "fontFamily": "Arial, sans-serif"
                      }
                    }
                  }
                ]
              },
              {
                "type": "ia.container.flex",
                "meta": { "name": "ATSMountainLogo" },
                "props": {
                  "direction": "column",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "style": {
                    "backgroundColor": "#E8A020",
                    "width": "36px",
                    "height": "36px",
                    "borderRadius": "2px"
                  }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "props": {
                      "text": "▲",
                      "style": {
                        "color": "#FFFFFF",
                        "fontSize": "20px",
                        "lineHeight": "1",
                        "textShadow": "0 2px 0 rgba(0,0,0,0.3)"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": { "name": "TabRow" },
        "position": { "basis": "30px", "shrink": 0 },
        "props": {
          "direction": "row",
          "alignItems": "stretch",
          "style": {
            "backgroundColor": "#222222",
            "borderBottom": "1px solid #111111"
          }
        },
        "children": [
          {
            "type": "ia.input.button",
            "meta": { "name": "Tab_STEM" },
            "position": { "grow": 1 },
            "propConfig": {
              "props.style.color": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/symposium', '#FFFFFF', '#909090')" }
              },
              "props.style.borderBottom": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/symposium', '2px solid #FFFFFF', '2px solid transparent')" }
              },
              "props.style.fontWeight": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/symposium', '700', '400')" }
              }
            },
            "props": {
              "text": "STEM Symposium",
              "action": { "type": "page", "config": { "url": "/symposium" } },
              "style": { "backgroundColor": "transparent", "color": "#909090", "fontSize": "12px", "fontFamily": "monospace", "border": "none", "borderBottom": "2px solid transparent", "borderRadius": "0", "padding": "0 4px" }
            }
          },
          {
            "type": "ia.input.button",
            "meta": { "name": "Tab_Overview" },
            "position": { "grow": 1 },
            "propConfig": {
              "props.style.color": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/overview' || {page.props.path} == '/', '#FFFFFF', '#909090')" }
              },
              "props.style.borderBottom": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/overview' || {page.props.path} == '/', '2px solid #FFFFFF', '2px solid transparent')" }
              },
              "props.style.fontWeight": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/overview' || {page.props.path} == '/', '700', '400')" }
              }
            },
            "props": {
              "text": "Overview",
              "action": { "type": "page", "config": { "url": "/overview" } },
              "style": { "backgroundColor": "transparent", "color": "#909090", "fontSize": "12px", "fontFamily": "monospace", "border": "none", "borderBottom": "2px solid transparent", "borderRadius": "0", "padding": "0 4px" }
            }
          },
          {
            "type": "ia.input.button",
            "meta": { "name": "Tab_Process" },
            "position": { "grow": 1 },
            "propConfig": {
              "props.style.color": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/process', '#FFFFFF', '#909090')" }
              },
              "props.style.borderBottom": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/process', '2px solid #FFFFFF', '2px solid transparent')" }
              },
              "props.style.fontWeight": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/process', '700', '400')" }
              }
            },
            "props": {
              "text": "Process",
              "action": { "type": "page", "config": { "url": "/process" } },
              "style": { "backgroundColor": "transparent", "color": "#909090", "fontSize": "12px", "fontFamily": "monospace", "border": "none", "borderBottom": "2px solid transparent", "borderRadius": "0", "padding": "0 4px" }
            }
          },
          {
            "type": "ia.input.button",
            "meta": { "name": "Tab_FillingTank" },
            "position": { "grow": 1 },
            "propConfig": {
              "props.style.color": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/filling-tank' || {page.props.path} == '/sensor' || {page.props.path} == '/filling' || {page.props.path} == '/tank', '#FFFFFF', '#909090')" }
              },
              "props.style.borderBottom": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/filling-tank' || {page.props.path} == '/sensor' || {page.props.path} == '/filling' || {page.props.path} == '/tank', '2px solid #FFFFFF', '2px solid transparent')" }
              },
              "props.style.fontWeight": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/filling-tank' || {page.props.path} == '/sensor' || {page.props.path} == '/filling' || {page.props.path} == '/tank', '700', '400')" }
              }
            },
            "props": {
              "text": "Filling & Tank",
              "action": { "type": "page", "config": { "url": "/filling-tank" } },
              "style": { "backgroundColor": "transparent", "color": "#909090", "fontSize": "12px", "fontFamily": "monospace", "border": "none", "borderBottom": "2px solid transparent", "borderRadius": "0", "padding": "0 4px" }
            }
          },
          {
            "type": "ia.input.button",
            "meta": { "name": "Tab_Alarms" },
            "position": { "grow": 1 },
            "propConfig": {
              "props.style.color": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/alarms', '#FFFFFF', '#909090')" }
              },
              "props.style.borderBottom": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/alarms', '2px solid #FFFFFF', '2px solid transparent')" }
              },
              "props.style.fontWeight": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/alarms', '700', '400')" }
              }
            },
            "props": {
              "text": "Alarms",
              "action": { "type": "page", "config": { "url": "/alarms" } },
              "style": { "backgroundColor": "transparent", "color": "#909090", "fontSize": "12px", "fontFamily": "monospace", "border": "none", "borderBottom": "2px solid transparent", "borderRadius": "0", "padding": "0 4px" }
            }
          },
          {
            "type": "ia.input.button",
            "meta": { "name": "Tab_Credits" },
            "position": { "grow": 1 },
            "propConfig": {
              "props.style.color": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/credits', '#FFFFFF', '#909090')" }
              },
              "props.style.borderBottom": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/credits', '2px solid #FFFFFF', '2px solid transparent')" }
              },
              "props.style.fontWeight": {
                "binding": { "type": "expr", "expression": "if({page.props.path} == '/credits', '700', '400')" }
              }
            },
            "props": {
              "text": "Credits",
              "action": { "type": "page", "config": { "url": "/credits" } },
              "style": { "backgroundColor": "transparent", "color": "#909090", "fontSize": "12px", "fontFamily": "monospace", "border": "none", "borderBottom": "2px solid transparent", "borderRadius": "0", "padding": "0 4px" }
            }
          }
        ]
      }
    ]
  }
}
