        "position": { "basis": "56px", "shrink": 0 },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "type": "tag",
              "tagPath": "[default]BFS/System/State",
              "transforms": [
                {
                  "type": "map",
                  "map": { "0": "#546E7A", "1": "#00695C", "2": "#B71C1C" },
                  "fallback": "#37474F"
                }
              ]
            }
          }
        },
        "props": {
          "direction": "row",
          "justify": "space-between",
          "alignItems": "center",
