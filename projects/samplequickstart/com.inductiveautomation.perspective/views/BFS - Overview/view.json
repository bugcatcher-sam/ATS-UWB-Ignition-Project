            "backgroundColor": "#546E7A",
            "padding": "0 24px",
            "borderBottom": "2px solid #263238"
          }
        },
        "children": [
          {
            "meta": { "name": "ScreenTitle" },
            "position": { "shrink": 0 },
            "props": {
              "text": "BOTTLE FILLING STATION  |  UNIT OVERVIEW",
