                "color": "#ECEFF1",
                "fontSize": "16px",
                "fontWeight": "600",
                "letterSpacing": "1px",
                "fontFamily": "monospace"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": { "name": "StateLabel" },
            "position": { "shrink": 0 },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "tag",
                  "tagPath": "[default]BFS/System/State",
                  "transforms": [
                    {
                      "type": "map",
                      "map": { "0": "STOPPED", "1": "RUNNING", "2": "FAULT" },
                      "fallback": "UNKNOWN"
                    }
                  ]
