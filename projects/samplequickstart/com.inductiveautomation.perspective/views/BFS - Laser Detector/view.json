{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 900,
      "width": 1280
    }
  },
  "root": {
    "children": [
      {
        "meta": { "name": "Header" },
        "position": { "basis": "56px", "shrink": 0 },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": {
            "backgroundColor": "#37474F",
            "padding": "0 24px",
            "gap": "16px",
            "borderBottom": "2px solid #263238"
          }
        },
        "children": [
          {
            "meta": { "name": "BackBtn" },
            "props": {
              "text": "‹ OVERVIEW",
              "style": {
                "backgroundColor": "#455A64",
                "color": "#B0BEC5",
                "fontSize": "12px",
                "padding": "6px 14px",
                "fontFamily": "monospace",
                "letterSpacing": "0.5px"
              },
              "action": { "type": "page", "config": { "url": "/bfs-overview" } }
            },
            "type": "ia.input.button"
          },
          {
            "meta": { "name": "Title" },
            "position": { "grow": 1 },
            "props": {
              "text": "LASER DETECTOR  —  LS-01  |  LEVEL 3 DETAIL",
              "style": {
                "color": "#ECEFF1",
                "fontSize": "15px",
                "fontWeight": "600",
                "letterSpacing": "1px",
                "fontFamily": "monospace"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": { "name": "Timestamp" },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "expression": "dateFormat(now(), 'yyyy-MM-dd  HH:mm:ss')"
                }
              }
            },
            "props": {
              "text": "",
              "style": { "color": "#78909C", "fontSize": "12px", "fontFamily": "monospace" }
            },
            "type": "ia.display.label"
          }
        ],
        "type": "ia.container.flex"
      },
      {
        "meta": { "name": "ContentArea" },
        "position": { "grow": 1, "basis": "0" },
        "props": {
          "direction": "row",
          "style": {
            "backgroundColor": "#546E7A",
            "padding": "24px",
            "gap": "24px"
          }
        },
        "children": [
          {
            "meta": { "name": "StatusColumn" },
            "position": { "basis": "320px", "shrink": 0 },
            "props": {
              "direction": "column",
              "style": { "gap": "16px" }
            },
            "children": [
              {
                "meta": { "name": "DetectionCard" },
                "props": {
                  "direction": "column",
                  "alignItems": "center",
                  "style": {
                    "backgroundColor": "#37474F",
                    "padding": "24px 16px",
                    "gap": "12px",
                    "borderRadius": "2px",
                    "border": "1px solid #455A64"
                  }
                },
                "children": [
                  {
                    "meta": { "name": "DetectionCardLabel" },
                    "props": {
                      "text": "DETECTION STATUS",
                      "style": { "color": "#78909C", "fontSize": "10px", "letterSpacing": "1.5px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "DetectionIndicator" },
                    "propConfig": {
                      "props.style.backgroundColor": {
                        "binding": {
                          "type": "tag",
                          "tagPath": "[default]BFS/Sensor/BottleDetected",
                          "transforms": [
                            {
                              "type": "map",
                              "map": { "true": "#004D40", "false": "#37474F" },
                              "fallback": "#37474F"
                            }
                          ]
                        }
                      },
                      "props.style.borderColor": {
                        "binding": {
                          "type": "tag",
                          "tagPath": "[default]BFS/Sensor/BottleDetected",
                          "transforms": [
                            {
                              "type": "map",
                              "map": { "true": "#80CBC4", "false": "#546E7A" },
                              "fallback": "#546E7A"
                            }
                          ]
                        }
                      }
                    },
                    "props": {
                      "style": {
                        "width": "120px",
                        "height": "120px",
                        "borderRadius": "50%",
                        "backgroundColor": "#37474F",
                        "border": "4px solid #546E7A",
                        "display": "flex",
                        "alignItems": "center",
                        "justifyContent": "center"
                      }
                    },
                    "children": [
                      {
                        "meta": { "name": "DetectionText" },
                        "propConfig": {
                          "props.text": {
                            "binding": {
                              "type": "tag",
                              "tagPath": "[default]BFS/Sensor/BottleDetected",
                              "transforms": [
                                {
                                  "type": "map",
                                  "map": { "true": "BOTTLE\nDETECTED", "false": "CLEAR" },
                                  "fallback": "UNKNOWN"
                                }
                              ]
                            }
                          },
                          "props.style.color": {
                            "binding": {
                              "type": "tag",
                              "tagPath": "[default]BFS/Sensor/BottleDetected",
                              "transforms": [
                                {
                                  "type": "map",
                                  "map": { "true": "#80CBC4", "false": "#78909C" },
                                  "fallback": "#78909C"
                                }
                              ]
                            }
                          }
                        },
                        "props": {
                          "text": "CLEAR",
                          "style": {
                            "color": "#78909C",
                            "fontSize": "15px",
                            "fontWeight": "700",
                            "letterSpacing": "1px",
                            "textAlign": "center",
                            "fontFamily": "monospace"
                          }
                        },
                        "type": "ia.display.label"
                      }
                    ],
                    "type": "ia.container.flex"
                  }
                ],
                "type": "ia.container.flex"
              },
              {
                "meta": { "name": "HealthCard" },
                "props": {
                  "direction": "column",
                  "style": {
                    "backgroundColor": "#37474F",
                    "padding": "16px",
                    "gap": "10px",
                    "borderRadius": "2px",
                    "border": "1px solid #455A64"
                  }
                },
                "children": [
                  {
                    "meta": { "name": "HealthLabel" },
                    "props": {
                      "text": "SENSOR HEALTH",
                      "style": { "color": "#78909C", "fontSize": "10px", "letterSpacing": "1.5px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "HealthRow" },
                    "props": {
                      "direction": "row",
                      "alignItems": "center",
                      "style": { "gap": "10px" }
                    },
                    "children": [
                      {
                        "meta": { "name": "HealthDot" },
                        "propConfig": {
                          "props.style.backgroundColor": {
                            "binding": {
                              "type": "tag",
                              "tagPath": "[default]BFS/Sensor/Health",
                              "transforms": [
                                {
                                  "type": "map",
                                  "map": { "true": "#00695C", "false": "#B71C1C" },
                                  "fallback": "#B71C1C"
                                }
                              ]
                            }
                          }
                        },
                        "props": {
                          "style": {
                            "width": "14px",
                            "height": "14px",
                            "borderRadius": "50%",
                            "backgroundColor": "#00695C",
                            "flexShrink": "0"
                          }
                        },
                        "type": "ia.container.flex"
                      },
                      {
                        "meta": { "name": "HealthText" },
                        "propConfig": {
                          "props.text": {
                            "binding": {
                              "type": "tag",
                              "tagPath": "[default]BFS/Sensor/Health",
                              "transforms": [
                                {
                                  "type": "map",
                                  "map": { "true": "OK  —  Beam aligned and receiving", "false": "FAULT  —  Check beam alignment" },
                                  "fallback": "UNKNOWN"
                                }
                              ]
                            }
                          },
                          "props.style.color": {
                            "binding": {
                              "type": "tag",
                              "tagPath": "[default]BFS/Sensor/Health",
                              "transforms": [
                                {
                                  "type": "map",
                                  "map": { "true": "#80CBC4", "false": "#EF9A9A" },
                                  "fallback": "#90A4AE"
                                }
                              ]
                            }
                          }
                        },
                        "props": {
                          "text": "OK",
                          "style": { "color": "#80CBC4", "fontSize": "13px", "fontFamily": "monospace" }
                        },
                        "type": "ia.display.label"
                      }
                    ],
                    "type": "ia.container.flex"
                  }
                ],
                "type": "ia.container.flex"
              },
              {
                "meta": { "name": "SpecCard" },
                "props": {
                  "direction": "column",
                  "style": {
                    "backgroundColor": "#37474F",
                    "padding": "16px",
                    "gap": "10px",
                    "borderRadius": "2px",
                    "border": "1px solid #455A64"
                  }
                },
                "children": [
                  {
                    "meta": { "name": "SpecLabel" },
                    "props": {
                      "text": "DEVICE SPECIFICATIONS",
                      "style": { "color": "#78909C", "fontSize": "10px", "letterSpacing": "1.5px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "SpecTag" },
                    "props": {
                      "text": "Tag ID:   [default]BFS/Sensor/BottleDetected",
                      "style": { "color": "#90A4AE", "fontSize": "11px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "SpecType" },
                    "props": {
                      "text": "Type:     Thru-Beam Laser Detector",
                      "style": { "color": "#90A4AE", "fontSize": "11px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "SpecTarget" },
                    "props": {
                      "text": "Target:   16.9 oz (500 mL) bottles",
                      "style": { "color": "#90A4AE", "fontSize": "11px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "SpecOutput" },
                    "props": {
                      "text": "Output:   Digital Boolean (TRUE = beam broken)",
                      "style": { "color": "#90A4AE", "fontSize": "11px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "SpecLoop" },
                    "props": {
                      "text": "Loop:     Bottle Filling Control Interlock",
                      "style": { "color": "#90A4AE", "fontSize": "11px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  }
                ],
                "type": "ia.container.flex"
              }
            ],
            "type": "ia.container.flex"
          },
          {
            "meta": { "name": "DiagramColumn" },
            "position": { "grow": 1, "basis": "0" },
            "props": {
              "direction": "column",
              "style": { "gap": "16px" }
            },
            "children": [
              {
                "meta": { "name": "DiagramCard" },
                "position": { "basis": "280px", "shrink": 0 },
                "props": {
                  "direction": "column",
                  "style": {
                    "backgroundColor": "#37474F",
                    "padding": "16px",
                    "borderRadius": "2px",
                    "border": "1px solid #455A64"
                  }
                },
                "children": [
                  {
                    "meta": { "name": "DiagramTitle" },
                    "props": {
                      "text": "DETECTOR SCHEMATIC  —  PLAN VIEW",
                      "style": { "color": "#78909C", "fontSize": "10px", "letterSpacing": "1.5px", "fontFamily": "monospace", "marginBottom": "12px" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "DiagramGraphic" },
                    "position": { "grow": 1, "basis": "0" },
                    "props": {
                      "style": { "position": "relative", "minHeight": "200px" }
                    },
                    "children": [
                      {
                        "meta": { "name": "ConveyorLine" },
                        "position": { "x": 40, "y": 90, "width": 620, "height": 12 },
                        "props": { "fill": "#455A64", "stroke": "#546E7A", "strokeWidth": 1 },
                        "type": "ia.shapes.rectangle"
                      },
                      {
                        "meta": { "name": "ConveyorLabel" },
                        "position": { "x": 40, "y": 110, "width": 100, "height": 16 },
                        "props": {
                          "text": "CONVEYOR",
                          "style": { "color": "#546E7A", "fontSize": "9px", "fontFamily": "monospace" }
                        },
                        "type": "ia.display.label"
                      },
                      {
                        "meta": { "name": "EmitterBox" },
                        "position": { "x": 40, "y": 30, "width": 80, "height": 52 },
                        "props": { "fill": "#37474F", "stroke": "#78909C", "strokeWidth": 2 },
                        "type": "ia.shapes.rectangle"
                      },
                      {
                        "meta": { "name": "EmitterText" },
                        "position": { "x": 55, "y": 48, "width": 50, "height": 18 },
                        "props": {
                          "text": "TX",
                          "style": { "color": "#B0BEC5", "fontSize": "14px", "fontWeight": "700", "textAlign": "center", "fontFamily": "monospace" }
                        },
                        "type": "ia.display.label"
                      },
                      {
                        "meta": { "name": "EmitterTagLabel" },
                        "position": { "x": 40, "y": 88, "width": 80, "height": 16 },
                        "props": {
                          "text": "EMITTER",
                          "style": { "color": "#546E7A", "fontSize": "9px", "textAlign": "center", "fontFamily": "monospace" }
                        },
                        "type": "ia.display.label"
                      },
                      {
                        "meta": { "name": "BeamLine" },
                        "position": { "x": 120, "y": 54, "width": 195, "height": 4 },
                        "propConfig": {
                          "props.fill": {
                            "binding": {
                              "type": "tag",
                              "tagPath": "[default]BFS/Sensor/BottleDetected",
                              "transforms": [
                                {
                                  "type": "map",
                                  "map": { "true": "#BF360C", "false": "#D50000" },
                                  "fallback": "#D50000"
                                }
                              ]
                            }
                          }
                        },
                        "props": { "fill": "#D50000", "stroke": "none" },
                        "type": "ia.shapes.rectangle"
                      },
                      {
                        "meta": { "name": "BottleSilhouette" },
                        "position": { "x": 295, "y": 20, "width": 50, "height": 80 },
                        "propConfig": {
                          "props.fill": {
                            "binding": {
                              "type": "tag",
                              "tagPath": "[default]BFS/Sensor/BottleDetected",
                              "transforms": [
                                {
                                  "type": "map",
                                  "map": { "true": "#37474F", "false": "#546E7A" },
                                  "fallback": "#546E7A"
                                }
                              ]
                            }
                          },
                          "props.stroke": {
                            "binding": {
                              "type": "tag",
                              "tagPath": "[default]BFS/Sensor/BottleDetected",
                              "transforms": [
                                {
                                  "type": "map",
                                  "map": { "true": "#80CBC4", "false": "#78909C" },
                                  "fallback": "#78909C"
                                }
                              ]
                            }
                          }
                        },
                        "props": { "fill": "#546E7A", "stroke": "#78909C", "strokeWidth": 2, "cornerRadius": 4 },
                        "type": "ia.shapes.rectangle"
                      },
                      {
                        "meta": { "name": "BeamLine2" },
                        "position": { "x": 345, "y": 54, "width": 195, "height": 4 },
                        "propConfig": {
                          "props.fill": {
                            "binding": {
                              "type": "tag",
                              "tagPath": "[default]BFS/Sensor/BottleDetected",
                              "transforms": [
                                {
                                  "type": "map",
                                  "map": { "true": "#546E7A", "false": "#D50000" },
                                  "fallback": "#D50000"
                                }
                              ]
                            }
                          }
                        },
                        "props": { "fill": "#D50000", "stroke": "none" },
                        "type": "ia.shapes.rectangle"
                      },
                      {
                        "meta": { "name": "ReceiverBox" },
                        "position": { "x": 540, "y": 30, "width": 80, "height": 52 },
                        "props": { "fill": "#37474F", "stroke": "#78909C", "strokeWidth": 2 },
                        "type": "ia.shapes.rectangle"
                      },
                      {
                        "meta": { "name": "ReceiverText" },
                        "position": { "x": 555, "y": 48, "width": 50, "height": 18 },
                        "props": {
                          "text": "RX",
                          "style": { "color": "#B0BEC5", "fontSize": "14px", "fontWeight": "700", "textAlign": "center", "fontFamily": "monospace" }
                        },
                        "type": "ia.display.label"
                      },
                      {
                        "meta": { "name": "ReceiverTagLabel" },
                        "position": { "x": 540, "y": 88, "width": 80, "height": 16 },
                        "props": {
                          "text": "RECEIVER",
                          "style": { "color": "#546E7A", "fontSize": "9px", "textAlign": "center", "fontFamily": "monospace" }
                        },
                        "type": "ia.display.label"
                      },
                      {
                        "meta": { "name": "LS01Label" },
                        "position": { "x": 260, "y": 110, "width": 120, "height": 24 },
                        "props": {
                          "text": "LS-01",
                          "style": { "color": "#546E7A", "fontSize": "11px", "textAlign": "center", "fontFamily": "monospace", "letterSpacing": "1px" }
                        },
                        "type": "ia.display.label"
                      }
                    ],
                    "type": "ia.container.coord"
                  }
                ],
                "type": "ia.container.flex"
              },
              {
                "meta": { "name": "OperatorNotesCard" },
                "props": {
                  "direction": "column",
                  "style": {
                    "backgroundColor": "#37474F",
                    "padding": "16px",
                    "borderRadius": "2px",
                    "border": "1px solid #455A64",
                    "gap": "8px"
                  }
                },
                "children": [
                  {
                    "meta": { "name": "NotesLabel" },
                    "props": {
                      "text": "OPERATOR NOTES  —  LS-01",
                      "style": { "color": "#78909C", "fontSize": "10px", "letterSpacing": "1.5px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "Note1" },
                    "props": {
                      "text": "•  Sensor triggers on beam interruption by bottle body (thru-beam mode).",
                      "style": { "color": "#90A4AE", "fontSize": "12px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "Note2" },
                    "props": {
                      "text": "•  Bottle must interrupt beam for ≥ 50 ms before fill sequence starts.",
                      "style": { "color": "#90A4AE", "fontSize": "12px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "Note3" },
                    "props": {
                      "text": "•  If Health = FAULT: check 24 VDC supply, beam alignment, and lens cleanliness.",
                      "style": { "color": "#90A4AE", "fontSize": "12px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "Note4" },
                    "props": {
                      "text": "•  Designed for 16.9 oz (500 mL) round PET bottles only.",
                      "style": { "color": "#90A4AE", "fontSize": "12px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  }
                ],
                "type": "ia.container.flex"
              }
            ],
            "type": "ia.container.flex"
          }
        ],
        "type": "ia.container.flex"
      }
    ],
    "meta": { "name": "root" },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "#546E7A",
        "height": "100%",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
