{
  "tagType": "Folder",
  "name": "BFS",
  "tags": [
    {
      "tagType": "Folder",
      "name": "System",
      "tags": [
        {
          "tagType": "AtomicTag",
          "name": "State",
          "dataType": "Int2",
          "valueSource": "memory",
          "value": 0,
          "tooltip": "0=Stopped, 1=Running, 2=Fault",
          "alarms": [
            {
              "name": "System Fault",
              "label": "BFS System Fault",
              "mode": "AboveValue",
              "setpointA": 1.5,
              "priority": "Critical",
              "enabled": true,
              "ackMode": "Manual",
              "notes": "System has entered a fault state. Investigate and reset before restarting."
            }
          ]
        },
        {
          "tagType": "AtomicTag",
          "name": "SystemMode",
          "dataType": "String",
          "valueSource": "memory",
          "value": "STOPPED",
          "tooltip": "STOPPED | AUTO | MANUAL | MAINTENANCE"
        },
        {
          "tagType": "AtomicTag",
          "name": "StartCmd",
          "dataType": "Boolean",
          "valueSource": "memory",
          "value": false,
          "tooltip": "Momentary start command"
        },
        {
          "tagType": "AtomicTag",
          "name": "StopCmd",
          "dataType": "Boolean",
          "valueSource": "memory",
          "value": false,
          "tooltip": "Momentary stop command"
        },
        {
          "tagType": "AtomicTag",
          "name": "FaultReset",
          "dataType": "Boolean",
          "valueSource": "memory",
          "value": false,
          "tooltip": "Momentary fault reset command"
        },
        {
          "tagType": "AtomicTag",
          "name": "EStop",
          "dataType": "Boolean",
          "valueSource": "memory",
          "value": false,
          "tooltip": "Emergency stop active",
          "alarms": [
            {
              "name": "Emergency Stop",
              "label": "BFS Emergency Stop Activated",
              "mode": "Equals",
              "setpointA": 1,
              "priority": "Critical",
              "enabled": true,
              "ackMode": "Manual",
              "notes": "E-Stop has been activated. Clear the E-Stop and reset before restarting."
            }
          ]
        },
        {
          "tagType": "AtomicTag",
          "name": "AlarmActiveCount",
          "dataType": "Int4",
          "valueSource": "memory",
          "value": 0,
          "tooltip": "Total active alarms"
        },
        {
          "tagType": "AtomicTag",
          "name": "AlarmUnackCount",
          "dataType": "Int4",
          "valueSource": "memory",
          "value": 0,
          "tooltip": "Unacknowledged alarm count"
        },
        {
          "tagType": "AtomicTag",
          "name": "SystemRunning",
          "dataType": "Boolean",
          "valueSource": "memory",
          "value": false,
          "tooltip": "True when system is in running state"
        }
      ]
    },
