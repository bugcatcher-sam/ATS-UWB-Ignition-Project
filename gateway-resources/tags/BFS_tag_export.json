        {
          "tagType": "AtomicTag",
          "name": "LS001_Sensitivity",
          "dataType": "Float4",
          "valueSource": "memory",
          "value": 75.0,
          "tooltip": "Laser sensitivity calibration setpoint",
          "engUnit": "%"
